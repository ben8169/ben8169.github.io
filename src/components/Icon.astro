---
import ArrowUpRight from "@tabler/icons/outline/arrow-up-right.svg";
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import Github from "@tabler/icons/outline/brand-github.svg";
import Instagram from "@tabler/icons/outline/brand-instagram.svg";
import Linkedin from "@tabler/icons/outline/brand-linkedin.svg";
import X from "@tabler/icons/outline/brand-x.svg";
import Mail from "@tabler/icons/outline/mail.svg";
import MapPin from "@tabler/icons/outline/map-pin.svg";
import Rss from "@tabler/icons/outline/rss.svg";
import World from "@tabler/icons/outline/world.svg";

// To add an icon: find its name at https://tabler.io/icons, import it, and register it below.
const icons = {
  "arrow-up-right": ArrowUpRight,
  "arrow-right": ArrowRight,
  github: Github,
  instagram: Instagram,
  linkedin: Linkedin,
  x: X,
  mail: Mail,
  "map-pin": MapPin,
  rss: Rss,
  website: World,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const Svg = icons[name];
---

<Svg
  width={size}
  height={size}
  stroke-width={1.75}
  aria-hidden="true"
  class={className}
/>
