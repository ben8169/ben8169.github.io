---
/**
 * List of experience/project cards. Hovering one card dims the others.
 */
---

<ol class="entries">
  <slot />
</ol>

<style>
  .entries {
    display: grid;
    gap: 3rem;
    /* Cards switch to a two-column layout based on the list's own width. */
    container-type: inline-size;
  }

  @media (min-width: 1024px) and (hover: hover) {
    .entries:hover > :global(li:not(:hover)) {
      opacity: 0.5;
    }
  }
</style>
