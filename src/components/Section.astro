---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`}>
  <div class="heading">
    <h2 id={`${id}-title`}>{title}</h2>
  </div>
  <slot />
</section>

<style>
  section {
    margin-bottom: 6rem;
  }

  /* 모바일: 스크롤할 때 섹션 제목이 상단에 고정됩니다. */
  .heading {
    position: sticky;
    top: 0;
    z-index: 10;
    margin-inline: -1.5rem;
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: color-mix(in srgb, var(--color-bg) 75%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .heading {
      margin-inline: -3rem;
      padding-inline: 3rem;
    }
  }

  /* 데스크톱: 왼쪽 내비게이션이 제목 역할을 하므로 시각적으로 숨깁니다. */
  @media (min-width: 1024px) {
    section {
      margin-bottom: 9rem;
    }

    .heading {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
</style>
