---
import Icon, { type IconName } from "@/components/Icon.astro";
import type { Honor } from "@/data/profile";

interface Props {
  heading: string;
  icon: IconName;
  items: Honor[];
}

const { heading, icon, items } = Astro.props;
---

<div class="group">
  <h3>{heading}</h3>
  <ul>
    {items.map((item) => (
      <li>
        <Icon name={icon} size={18} class="icon" />
        <div>
          <p class="name">{item.name}</p>
          {item.detail && <p class="detail">{item.detail}</p>}
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .group + .group {
    margin-top: 3rem;
  }

  h3 {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  ul {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  li {
    display: flex;
    gap: 0.875rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-border);
  }

  li :global(.icon) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--color-accent);
  }

  .name {
    color: var(--color-heading);
    font-weight: 500;
    line-height: 1.5;
  }

  .detail {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    li > div {
      display: flex;
      flex: 1;
      justify-content: space-between;
      align-items: baseline;
      gap: 1.5rem;
    }

    .detail {
      flex-shrink: 0;
      text-align: right;
    }
  }
</style>
