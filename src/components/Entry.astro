---
import Icon from "@/components/Icon.astro";

interface Props {
  title: string;
  /** Secondary text next to the title, e.g. the company */
  subtitle?: string;
  href?: string;
  description: string;
  tags?: string[];
  /** Left column: date range */
  period?: string;
  /** Left column: thumbnail image (takes precedence over period) */
  image?: string;
}

const {
  title,
  subtitle,
  href,
  description,
  tags = [],
  period,
  image,
} = Astro.props;
const isExternal = href?.startsWith("http");
---

<li class:list={["entry", { "no-aside": !image && !period }]}>
  <div class="backdrop" aria-hidden="true"></div>

  {(image || period) && (
    <div class="aside">
      {image ? (
        <img
          class="thumb"
          src={image}
          alt=""
          width="200"
          height="125"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <p class="period">{period}</p>
      )}
    </div>
  )}

  <div class="body">
    <h3>
      {href ? (
        <a
          class="title-link"
          href={href}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener noreferrer" : undefined}
        >
          <span>
            {title}
            {subtitle && <span class="subtitle"> · {subtitle}</span>}
          </span>
          <Icon name="arrow-up-right" size={16} class="arrow" />
        </a>
      ) : (
        <span>
          {title}
          {subtitle && <span class="subtitle"> · {subtitle}</span>}
        </span>
      )}
    </h3>
    <p class="description">{description}</p>
    {tags.length > 0 && (
      <ul class="tags" aria-label="Technologies">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )}
  </div>
</li>

<style>
  .entry {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 0.75rem;
    transition: opacity 0.3s var(--ease);
  }

  .backdrop {
    position: absolute;
    inset: -1rem -1.5rem;
    z-index: -1;
    border-radius: var(--radius);
    transition:
      background-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .period {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .thumb {
    width: 100%;
    max-width: 12rem;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    transition: border-color 0.3s var(--ease);
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .title-link {
    display: inline;
    transition: color 0.2s;
  }

  /* Stretch the title link over the whole card so the entire card is clickable. */
  .title-link::after {
    content: "";
    position: absolute;
    inset: -1rem -1.5rem;
    border-radius: var(--radius);
  }

  .subtitle {
    font-weight: 500;
    color: var(--color-muted);
  }

  /* Keep the arrow inline so it follows the last word, even when the title wraps. */
  .title-link :global(.arrow) {
    display: inline-block;
    margin-left: 0.25rem;
    vertical-align: -0.125em;
    transition: transform 0.2s var(--ease);
  }

  .description {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tags li {
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .entry:hover .title-link,
  .title-link:focus-visible {
    color: var(--color-accent);
  }

  .entry:hover .title-link :global(.arrow),
  .title-link:focus-visible :global(.arrow) {
    transform: translate(2px, -2px);
  }

  .entry:hover .thumb {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  /* Put the date beside the content only when the list is wide enough. */
  @container (min-width: 31rem) {
    .entry {
      grid-template-columns: 10rem 1fr;
      gap: 1.5rem;
    }

    .period {
      white-space: nowrap;
    }

    .entry.no-aside {
      grid-template-columns: 1fr;
    }
  }

  @media (hover: hover) {
    .entry:hover .backdrop {
      background: var(--color-surface-hover);
      box-shadow:
        var(--shadow-card),
        0 0 0 1px var(--color-border);
    }
  }
</style>
