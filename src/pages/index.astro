---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sidebar from "@/components/Sidebar.astro";
import Section from "@/components/Section.astro";
import EntryList from "@/components/EntryList.astro";
import Entry from "@/components/Entry.astro";
import Icon from "@/components/Icon.astro";
import Footer from "@/components/Footer.astro";
import { profile } from "@/data/profile";

// Only sections that have content appear in the nav and the page.
const nav = [
  { id: "about", label: "About", show: profile.about.length > 0 },
  {
    id: "experience",
    label: "Experience",
    show: profile.experience.length > 0,
  },
  { id: "projects", label: "Projects", show: profile.projects.length > 0 },
].filter((item) => item.show);
---

<BaseLayout>
  <div class="page">
    <Sidebar nav={nav} />

    <main id="content" class="reveal" style="--i: 3">
      {profile.about.length > 0 && (
        <Section id="about" title="About">
          <div class="about">
            {profile.about.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
          </div>
        </Section>
      )}

      {profile.experience.length > 0 && (
        <Section id="experience" title="Experience">
          <EntryList>
            {profile.experience.map((item) => (
              <Entry
                title={item.title}
                subtitle={item.company}
                href={item.href}
                description={item.description}
                tags={item.tags}
                period={item.period}
              />
            ))}
          </EntryList>
          {profile.resume && (
            <a
              class="more"
              href={profile.resume}
              target="_blank"
              rel="noopener noreferrer"
            >
              View full résumé
              <Icon name="arrow-right" size={16} />
            </a>
          )}
        </Section>
      )}

      {profile.projects.length > 0 && (
        <Section id="projects" title="Projects">
          <EntryList>
            {profile.projects.map((project) => (
              <Entry
                title={project.title}
                href={project.href}
                description={project.description}
                tags={project.tags}
                image={project.image}
              />
            ))}
          </EntryList>
        </Section>
      )}

      <Footer />
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .about {
    display: grid;
    gap: 1.25rem;
  }

  .about :global(a) {
    color: var(--color-heading);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
    transition: color 0.2s;
  }

  .about :global(a:hover) {
    color: var(--color-accent);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .more:hover {
    color: var(--color-accent);
  }

  .more :global(svg) {
    transition: transform 0.2s var(--ease);
  }

  .more:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (min-width: 768px) {
    .page {
      padding-inline: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .page {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 4rem;
      padding-inline: 6rem;
    }

    main {
      padding-top: 6rem;
    }
  }
</style>
