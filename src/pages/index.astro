---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sidebar from "@/components/Sidebar.astro";
import Section from "@/components/Section.astro";
import EntryList from "@/components/EntryList.astro";
import Entry from "@/components/Entry.astro";
import HonorList from "@/components/HonorList.astro";
import PublicationEntry from "@/components/PublicationEntry.astro";
import Icon from "@/components/Icon.astro";
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";
import { profile } from "@/data/profile";

const hasCorrespondingMark = profile.publications.some((p) =>
  p.authors.includes("†"),
);

const hasHonors =
  profile.awards.length > 0 || profile.certifications.length > 0;

// Only sections that have content appear in the nav and the page.
const nav = [
  { id: "about", label: "About", show: profile.about.length > 0 },
  // { id: "education", label: "Education", show: profile.education.length > 0 },
  {
    id: "publications",
    label: "Publications",
    show: profile.publications.length > 0,
  },
  {
    id: "experience",
    label: "Experience",
    show: profile.experience.length > 0,
  },
  { id: "projects", label: "Projects", show: profile.projects.length > 0 },
  { id: "honors", label: "Honors", show: hasHonors },
].filter((item) => item.show);
---

<BaseLayout>
  <div class="page">
    <Sidebar nav={nav} />

    <main id="content" class="reveal" style="--i: 3">
      {profile.about.length > 0 && (
        <Section id="about" title="About">
          {profile.photo && (
            <Image
              class="avatar"
              src={profile.photo}
              alt={`Portrait of ${profile.name}`}
              width={120}
              height={120}
              densities={[1, 2]}
              loading="eager"
            />
          )}
          <div class="about">
            {profile.about.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
          </div>
          {profile.skills.length > 0 && (
            <ul class="skills" aria-label="Skills">
              {profile.skills.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          )}
        </Section>
      )}

      {/*
        Education — hidden for now. To restore it, uncomment this block and
        the "education" entry in `nav` above.

      {profile.education.length > 0 && (
        <Section id="education" title="Education">
          <EntryList>
            {profile.education.map((item) => (
              <Entry
                title={item.school}
                href={item.href}
                description={item.degree}
                period={item.period}
              />
            ))}
          </EntryList>
        </Section>
      )}
      */}

      {profile.publications.length > 0 && (
        <Section id="publications" title="Publications">
          <EntryList>
            {profile.publications.map((publication) => (
              <PublicationEntry {...publication} />
            ))}
          </EntryList>
          {hasCorrespondingMark && (
            <p class="footnote">† Corresponding author</p>
          )}
        </Section>
      )}

      {profile.experience.length > 0 && (
        <Section id="experience" title="Experience">
          <EntryList>
            {profile.experience.map((item) => (
              <Entry
                title={item.title}
                subtitle={item.company}
                href={item.href}
                description={item.description}
                tags={item.tags}
                period={item.period}
              />
            ))}
          </EntryList>
          {profile.resume && (
            <a
              class="more"
              href={profile.resume}
              target="_blank"
              rel="noopener noreferrer"
            >
              View full résumé
              <Icon name="arrow-right" size={16} />
            </a>
          )}
        </Section>
      )}

      {profile.projects.length > 0 && (
        <Section id="projects" title="Projects">
          <EntryList>
            {profile.projects.map((project) => (
              <Entry
                title={project.title}
                href={project.href}
                description={project.description}
                tags={project.tags}
                image={project.image}
                period={project.period}
              />
            ))}
          </EntryList>
        </Section>
      )}

      {hasHonors && (
        <Section id="honors" title="Honors">
          {profile.awards.length > 0 && (
            <HonorList heading="Awards" icon="trophy" items={profile.awards} />
          )}
          {profile.certifications.length > 0 && (
            <HonorList
              heading="Certifications"
              icon="certificate"
              items={profile.certifications}
            />
          )}
        </Section>
      )}

      <Footer />
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .avatar {
    width: 7.5rem;
    height: 7.5rem;
    margin-bottom: 2rem;
    border-radius: 50%;
    object-fit: cover;
    outline: 1px solid var(--color-border);
    outline-offset: 4px;
  }

  .about {
    display: grid;
    gap: 1.25rem;
  }

  .about :global(a) {
    color: var(--color-heading);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
    transition: color 0.2s;
  }

  .about :global(a:hover) {
    color: var(--color-accent);
  }

  .footnote {
    margin-top: 2.5rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .skills li {
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-heading);
    line-height: 1.6;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .more:hover {
    color: var(--color-accent);
  }

  .more :global(svg) {
    transition: transform 0.2s var(--ease);
  }

  .more:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (min-width: 768px) {
    .page {
      padding-inline: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .page {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 4rem;
      padding-inline: 6rem;
    }

    /*
     * About fills the first screen with its content vertically centered,
     * both on first load and when "About" is clicked in the nav.
     * Other sections keep scrolling to the top of the viewport.
     */
    main :global(#about) {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 100vh;
      min-height: 100dvh;
      margin-bottom: 0;
    }
  }
</style>
